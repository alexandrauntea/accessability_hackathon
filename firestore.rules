rules_version = '2';
// Owner: Alina. Health data = GDPR special category: every document lives under users/{uid}
// and only that user can read/write it. Cloud Functions use the Admin SDK and bypass rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /checkins/{date} { allow read, write: if isOwner(uid); }
      match /summaries/{date} { allow read: if isOwner(uid); allow write: if false; }
      match /dayPlans/{date} { allow read, write: if isOwner(uid); }
      match /requests/{id}  { allow read, write: if isOwner(uid); }
      // outbox is written only by functions (sendRequest); user can read what was sent
      match /outbox/{id}    { allow read: if isOwner(uid); allow write: if false; }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
