# Copy to .env (never commit .env). EXPO_PUBLIC_* values end up in the web bundle: no secrets here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FUNCTIONS_REGION=europe-west1

# true = hardcoded calendar / Jira / email. Flip per integration once the real one works.
EXPO_PUBLIC_MOCK_CALENDAR=true
EXPO_PUBLIC_MOCK_TASKS=true
EXPO_PUBLIC_MOCK_EMAIL=true

# Google OAuth web client id (Google Cloud console > Credentials) with Calendar API enabled
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# true = talk to local emulators (firebase emulators:start)
EXPO_PUBLIC_USE_EMULATORS=false

# Shows the 'load demo data' button in the deployed web build
EXPO_PUBLIC_DEMO_TOOLS=true
EXPO_PUBLIC_DEMO_MANAGER_EMAIL=
EXPO_PUBLIC_DEMO_HR_EMAIL=
