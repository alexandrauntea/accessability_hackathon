# functions/.env (non-secret config, deployed with functions). Copy to .env.
GEMINI_MODEL=gemini-2.5-flash
REGION=europe-west1
EMAIL_MODE=mock          # mock | smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
JIRA_BASE_URL=https://your-team.atlassian.net
JIRA_JQL=assignee=currentUser() AND statusCategory!=Done ORDER BY priority DESC
# Secrets go to Secret Manager, NOT here:
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set SMTP_USER   (use "none" until email goes real)
#   firebase functions:secrets:set SMTP_PASS
#   firebase functions:secrets:set JIRA_EMAIL  (use "none" until Jira goes real)
#   firebase functions:secrets:set JIRA_TOKEN
